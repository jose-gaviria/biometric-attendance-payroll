{
  "name": "attendance-payroll",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "concurrently -k \"vite --host 0.0.0.0\" \"tsx watch server/index.ts\"",
    "dev:web": "vite --host 0.0.0.0",
    "dev:api": "tsx watch server/index.ts",
    "build": "tsc -b && vite build && npm run server:build",
    "start": "node dist-server/index.js",
    "server:build": "tsc -p tsconfig.server.json",
    "test": "vitest run",
    "lint": "oxlint src server",
    "format": "oxfmt"
  },
  "dependencies": {
    "@fontsource/nunito": "^5.3.0",
    "bcryptjs": "^3.0.2",
    "better-sqlite3": "^12.2.0",
    "cookie-parser": "^1.4.7",
    "date-fns": "4.1.0",
    "express": "^5.1.0",
    "lucide-react": "1.31.0",
    "luxon": "^3.7.2",
    "pdfkit": "^0.20.2",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.13",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/luxon": "^3.7.1",
    "@types/node": "22.19.19",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "concurrently": "^9.2.1",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.2.1",
    "tsx": "^4.20.5",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "vitest": "^4.0.0",
    "wawoff2": "^2.0.1"
  }
}
