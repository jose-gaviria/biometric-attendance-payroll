# Build every component from the source kept in this repository. The final
# image contains the two Node runtimes, both applications and the face engine.
FROM node:24-bookworm-slim AS laboratory-build
WORKDIR /app
RUN apt-get update \
    && apt-get install -y --no-install-recommends python3 make g++ \
    && rm -rf /var/lib/apt/lists/*
COPY package.json package-lock.json ./
RUN npm ci
COPY client ./client
COPY server ./server
COPY scripts/*.ts ./scripts/
COPY tsconfig.json tsconfig.server.json vite.config.ts ./
RUN npm run build && npm prune --omit=dev && npm cache clean --force

FROM node:22-bookworm-slim AS attendance-build
WORKDIR /app
COPY turnos-app/package.json turnos-app/package-lock.json ./
RUN npm ci
COPY turnos-app/ ./
RUN npm run build && npm prune --omit=dev && npm cache clean --force

FROM python:3.12-slim-bookworm AS face-engine
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 MPLCONFIGDIR=/tmp/matplotlib
RUN apt-get update \
    && apt-get install -y --no-install-recommends libgl1 libglib2.0-0 libportaudio2 \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /service
COPY face-service/requirements.lock ./
RUN pip install --no-cache-dir -r requirements.lock
COPY face-service/engine.py face-service/main.py ./
COPY face-service/models ./models
RUN useradd --uid 10001 --create-home face

FROM face-engine
USER root
COPY --from=laboratory-build /usr/local/bin/node /usr/local/bin/node
COPY --from=attendance-build /usr/local/bin/node /usr/local/bin/node-turnos
COPY --from=laboratory-build /app/node_modules /opt/face-lab/node_modules
COPY --from=laboratory-build /app/dist /opt/face-lab/dist
COPY --from=laboratory-build /app/package.json /opt/face-lab/package.json
COPY --from=attendance-build /app/node_modules /opt/turnos/node_modules
COPY --from=attendance-build /app/dist /opt/turnos/dist
COPY --from=attendance-build /app/dist-server /opt/turnos/dist-server
COPY --from=attendance-build /app/assets /opt/turnos/assets
COPY --from=attendance-build /app/package.json /opt/turnos/package.json
COPY unified/supervisor.py unified/health.py unified/backup.py unified/import_data.py unified/verify_data.py unified/bootstrap.py /opt/unified/
RUN mkdir -p /data && chown 10001:10001 /data && chmod 700 /data \
    && /usr/local/bin/node --version && /usr/local/bin/node-turnos --version \
    && cd /opt/face-lab && node -e "require('better-sqlite3')(':memory:').close()" \
    && cd /opt/turnos && node-turnos -e "require('better-sqlite3')(':memory:').close()"
ENV NODE_ENV=production PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
USER 10001:10001
WORKDIR /opt/unified
EXPOSE 3001 8081
HEALTHCHECK --interval=15s --timeout=8s --start-period=60s --retries=3 CMD ["python", "/opt/unified/health.py"]
ENTRYPOINT ["python", "/opt/unified/supervisor.py"]
